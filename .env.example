# ============================================================
# PaperTrail — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Your Supabase project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key — safe for the browser (used by Next.js frontend)
SUPABASE_ANON_KEY=<your-supabase-anon-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service role key — BACKEND ONLY. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# JWT issuer — always https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# JWT secret — found in Supabase dashboard → Settings → API → JWT Secret
# Leave empty if your project uses RS256 (JWKS will be used instead)
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ── Database ─────────────────────────────────────────────────
# Use port 5432 (direct or session pooler). NEVER use port 6543 (transaction pooler).
# Local development (after `supabase start`):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
# Remote (replace with your project values):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave empty for local Docker; set for Qdrant Cloud
QDRANT_API_KEY=

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Academic Provider APIs ───────────────────────────────────
# Register at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Email used for OpenAlex and Crossref polite pools
OPENALEX_EMAIL=your@email.com
CROSSREF_EMAIL=your@email.com
UNPAYWALL_EMAIL=your@email.com

# ── LLM Providers (at least one required for RAG) ────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Options: ollama | openai | anthropic
PAPERTRAIL_LLM_PROVIDER=ollama

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_VERSION=1.5.0
EMBEDDING_DIMENSIONS=768
# hash | fastembed  (fastembed downloads BAAI/bge-base-en-v1.5)
EMBEDDING_BACKEND=hash
RERANKER_MODEL=BAAI/bge-reranker-base
BM25_MODEL=Qdrant/bm25
BM25_K1=1.2
BM25_B=0.75
GROBID_URL=http://localhost:8070

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated domain suffixes allowed for PDF fetching (SSRF allowlist)
PDF_FETCH_ALLOWED_DOMAINS=arxiv.org,export.arxiv.org,europepmc.org

# ── Observability ────────────────────────────────────────────
# Leave empty to disable Sentry
SENTRY_DSN=

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
